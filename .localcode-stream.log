# ─── Map Rendering ────────────────────────────────────────────────────────────────

class MapRenderer:
    """Renders the hex map to a canvas"""
    
    TERRAIN_COLORS = {
        TerrainType.PLAINS: "#90EE90",
        TerrainType.GRASSLAND: "#7CFC00",
        TerrainType.FOREST: "#228B22",
        TerrainType.HILLS: "#8B4513",
        TerrainType.MOUNTAIN: "#696969",
        TerrainType.DESERT: "#F4A460",
        TerrainType.TUNDRA: "#E0FFFF",
        TerrainType.WATER_COAST: "#4169E1",
        TerrainType.OCEAN: "#1E90FF",
    }
    
    TERRAIN_CHARS = {
        TerrainType.PLAINS: "·",
        TerrainType.GRASSLAND: "·",
        TerrainType.FOREST: "F",
        TerrainType.HILLS: "^",
        TerrainType.MOUNTAIN: "▲",
        TerrainType.DESERT: "·",
        TerrainType.TUNDRA: "·",
        TerrainType.WATER_COAST: "~",
        TerrainType.OCEAN: "≈",
    }
    
    def __init__(self, canvas: tk.Canvas, hex_map: HexMap, view_radius: int = 5):
        self.canvas = canvas
        self.hex_map = hex_map
        self.view_radius = view_radius
        self.view_center = (0, 0)
        self.tile_size = 20
        self.selected_tile = None
        self.hex_points = {}  # (x,y) -> list of 6 points
        
    def set_view(self, x: int, y: int):
        self.view_center = (x, y)
        self.render()
    
    def render(self):
        """Render the map to the canvas"""
        self.canvas.delete("all")
        
        cx, cy = self.view_center
        tile_size = self.tile_size
        
        for dy in range(-self.view_radius, self.view_radius + 1):
            for dx in range(-self.view_radius, self.view_radius + 1):
                tx, ty = cx + dx, cy + dy
                tile = self.hex_map.get_tile(tx, ty)
                
                if tile:
                    # Calculate hex center position
                    px = dx * tile_size
                    py = dy * tile_size
                    
                    # Draw hex
                    points = self._hex_points(px, py, tile_size)
                    color = self.TERRAIN_COLORS.get(tile.terrain, "#CCCCCC")
                    
                    self.canvas.create_polygon(
                        points, fill=color, outline="white", width=1
                    )
                    
                    # Draw terrain character
                    char = self.TERRAIN_CHARS.get(tile.terrain, "?")
                    self.canvas.create_text(
                        px, py, text=char, fill="black", font=("Courier", 10, "bold")
                    )
                    
                    # Draw city/unit/resource indicators
                    if tile.city:
                        self.canvas.create_text(
                            px, py - 12, text="C", fill="yellow", font=("Courier", 8, "bold")
                        )
                    elif tile.unit:
                        self.canvas.create_text(
                            px, py - 12, text="U", fill="red", font=("Courier", 8, "bold")
                        )
                    elif tile.resource:
                        self.canvas.create_text(
                            px, py - 12, text="R", fill="orange", font=("Courier", 8, "bold")
                        )
                    
                    # Highlight selected tile
                    if (tx, ty) == self.selected_tile:
                        self.canvas.create_polygon(
                            points, outline="yellow", width=3
                        )
                    
                    # Store hex points for click detection
                    self.hex_points[(tx, ty)] = points
                else:
                    # Empty space
                    px = dx * tile_size
                    py = dy * tile_size
                    points = self._hex_points(px, py, tile_size)
                    self.canvas.create_polygon(
                        points, fill="#222222", outline="black", width=1
                    )
    
    def _hex_points(self, cx: float, cy: float, size: float) -> List[Tuple[float, float]]:
        """Generate hexagon points"""
        points = []
        for i in range(6):
            angle = (60 * i - 30) * 3.14159 / 180
            x = cx + size * 0.8 * 1.5 * (i % 2 + 1) / 2
            y = cy + size * 0.8 * 1.0
            points.append((x, y))
        return points
    
    def get_tile_at_position(self, x: int, y: int) -> Optional[Tuple[int, int]]:
        """Get tile coordinates from canvas position"""
        cx, cy = self.view_center
        for (tx, ty), points in self.hex_points.items():
            for px, py in points:
                if abs(px - x) < self.tile_size and abs(py - y) < self.tile_size:
                    return (tx, ty)
        return None
    
    def center_on_city(self, city: City):
        """Center the view on a city"""
        self.set_view(city.position[0], city.position[1])


# ─── GUI Panels ────────────────────────────────────────────────────────────────────

class CityPanel(ttk.Frame):
    """Panel for city management"""
    
    def __init__(self, parent, city_manager: CityManager, on_select_city):
        super().__init__(parent)
        self.city_manager = city_manager
        self.on_select_city = on_select_city
        self.current_city = None
        
        self._build_ui()
    
    def _build_ui(self):
        ttk.Label(self, text="Cities", font=("Arial", 12, "bold")).pack(pady=(5, 5))
        
        self.city_listbox = tk.Listbox(self, width=30, height=10)
        self.city_listbox.pack(padx=5, pady=5)
        self.city_listbox.bind("<<ListboxSelect>>", self._on_select_city)
        
        # City details
        self.city_details = tk.Text(self, width=30, height=15, state=tk.DISABLED, font=("Courier", 9))
        self.city_details.pack(padx=5, pady=5)
        
        # Production controls
        self.prod_frame = ttk.Frame(self)
        self.prod_frame.pack(padx=5, pady=5)
        
        ttk.Label(self.prod_frame, text="Production:").pack(side=tk.LEFT)
        self.prod_entry = ttk.Entry(self.prod_frame, width=10)
        self.prod_entry.pack(side=tk.LEFT, padx=5)
        
        ttk.Button(self.prod_frame, text="Queue", command=self._queue_production).pack(side=tk.LEFT, padx=5)
        
        # City actions
        self.action_frame = ttk.Frame(self)
        self.action_frame.pack(padx=5, pady=5)
        
        ttk.Button(self.action_frame, text="Build District", command=self._build_district).pack(side=tk.LEFT, padx=2)
        ttk.Button(self.action_frame, text="Build Building", command=self._build_building).pack(side=tk.LEFT, padx=2)
        ttk.Button(self.action_frame, text="Train Unit", command=self._train_unit).pack(side=tk.LEFT, padx=2)
    
    def _on_select_city(self, event):
        selection = self.city_listbox.curselection()
        if selection:
            city_name = self.city_listbox.get(selection[0])
            self.current_city = self.city_manager.get_city(city_name)
            self.on_select_city(self.current_city)
            self._update_city_details()
    
    def update_city_list(self):
        """Update the city listbox"""
        self.city_listbox.delete(0, tk.END)
        for city in self.city_manager.cities:
            self.city_listbox.insert(tk.END, city.name)
    
    def _update_city_details(self):
        """Update the city details text widget"""
        if not self.current_city:
            return
        
        self.city_details.config(state=tk.NORMAL)
        self.city_details.delete(1.0, tk.END)
        
        details = [
            f"City: {self.current_city.name}",
            f"Owner: {self.current_city.owner}",
            f"Population: {self.current_city.population}",
            f"Gold: {self.current_city.gold}",
            f"Science: {self.current_city.science}",
            f"Happiness: {self.current_city.happiness}",
            f"Districts: {', '.join(self.current_city.districts.keys()) or 'None'}",
            f"Buildings: {', '.join(self.current_city.buildings.keys()) or 'None'}",
            f"Production Queue: {', '.join(self.current_city.production_queue) or 'Empty'}",
        ]
        
        self.city_details.insert(tk.END, "\n".join(details))
        self.city_details.config(state=tk.DISABLED)
    
    def _queue_production(self):
        """Add an item to the production queue"""
        if not self.current_city:
            return
        
        item = self.prod_entry.get().strip()
        if item:
            self.current_city.assign_production(item)
            self.prod_entry.delete(0, tk.END)
            self._update_city_details()
    
    def _build_district(self):
        """Build a district in the city"""
        if not self.current_city:
            return
        
        district_name = self._get_district_choice()
        if district_name:
            district_type = DISTRICTS.get(district_name)
            if district_type:
                self.current_city.add_district(district_type)
                self._update_city_details()
    
    def _build_building(self):
        """Build a building in the city"""
        if not self.current_city:
            return
        
        building_name = self._get_building_choice()
        if building_name:
            building_type = BUILDINGS.get(building_name)
            if building_type:
                self.current_city.add_building(building_type)
                self._update_city_details()
    
    def _train_unit(self):
        """Train a unit in the city"""
        if not self.current_city:
            return
        
        unit_name = self._get_unit_choice()
        if unit_name:
            self.current_city.assign_production(unit_name)
            self._update_city_details()
    
    def _get_district_choice(self) -> Optional[str]:
        """Get district choice from user"""
        dialog = tk.Toplevel(self)
        dialog.title("Select District")
        dialog.geometry("300x400")
        
        ttk.Label(dialog, text="Select District Type:", font=("Arial", 11, "bold")).pack(pady=10)
        
        listbox = tk.Listbox(dialog, width=30, height=10)
        listbox.pack(pady=5)
        
        for district_name in DISTRICTS.keys():
            listbox.insert(tk.END, district_name)
        
        def on_select():
            selection = listbox.curselection()
            if selection:
                result.set(listbox.get(selection[0]))
                dialog.destroy()
        
        result = tk.StringVar()
        ttk.Button(dialog, text="OK", command=on_select).pack(pady=5)
        ttk.Button(dialog, text="Cancel", command=dialog.destroy).pack(pady=5)
        
        dialog.wait_window()
        return result.get() if result.get() else None
    
    def _get_building_choice(self) -> Optional[str]:
        """Get building choice from user"""
        dialog = tk.Toplevel(self)
        dialog.title("Select Building")
        dialog.geometry("300x400")
        
        ttk.Label(dialog, text="Select Building:", font=("Arial", 11, "bold")).pack(pady=10)
        
        listbox = tk.Listbox(dialog, width=30, height=10)
        listbox.pack(pady=5)
        
        for building_name in BUILDINGS.keys():
            listbox.insert(tk.END, building_name)
        
        def on_select():
            selection = listbox.curselection()
            if selection:
                result.set(listbox.get(selection[0]))
                dialog.destroy()
        
        result = tk.StringVar()
        ttk.Button(dialog, text="OK", command=on_select).pack(pady=5)
        ttk.Button(dialog, text="Cancel", command=dialog.destroy).pack(pady=5)
        
        dialog.wait_window()
        return result.get() if result.get() else None
    
    def _get_unit_choice(self) -> Optional[str]:
        """Get unit choice from user"""
        dialog = tk.Toplevel(self)
        dialog.title("Select Unit")
        dialog.geometry("300x400")
        
        ttk.Label(dialog, text="Select Unit:", font=("Arial", 11, "bold")).pack(pady=10)
        
        listbox = tk.Listbox(dialog, width=30, height=10)
        listbox.pack(pady=5)
        
        for unit_name in UNIT_TYPES.keys():

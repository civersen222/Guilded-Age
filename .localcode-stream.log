```python
from enum import Enum
from typing import Dict, List, Tuple, Set
import random

class TerrainType(Enum):
    PLAINS = "PLAINS"
    MOUNTAIN = "MOUNTAIN"
    FOREST = "FOREST"
    WATER = "WATER"

# Default yields for each terrain type
TERRAIN_YIELDS = {
    TerrainType.PLAINS: {'food': 2, 'production': 1, 'gold': 1, 'science': 0},
    TerrainType.MOUNTAIN: {'food': 0, 'production': 3, 'gold': 2, 'science': 1},
    TerrainType.FOREST: {'food': 1, 'production': 2, 'gold': 0, 'science': 1},
    TerrainType.WATER: {'food': 1, 'production': 0, 'gold': 1, 'science': 1},
}

class HexTile:
    def __init__(self, q: int, r: int, terrain_type: TerrainType):
        self.q = q
        self.r = r
        self.terrain_type = terrain_type
        self.yields = TERRAIN_YIELDS[terrain_type].copy()

    def __repr__(self):
        return f"HexTile({self.q}, {self.r}, {self.terrain_type.name})"

class WorldMap:
    def __init__(self):
        # Storage: {(q, r): HexTile}
        self.tiles: Dict[Tuple[int, int], HexTile] = {}

    def get_tile(self, q: int, r: int) -> HexTile:
        return self.tiles.get((q, r))

    def get_distance(self, tile_a: HexTile, tile_b: HexTile) -> int:
        return (abs(tile_a.q - tile_b.q) + 
                abs(tile_a.q + tile_a.r - tile_b.q - tile_b.r) + 
                abs(tile_a.r - tile_b.r)) // 2

    def get_neighbors(self, q: int, r: int) -> List[Tuple[int, int]]:
        # Axial neighbor offsets
        directions = [
            (1, 0), (1, -1), (0, -1),
            (-1, 0), (-1, 1), (0, 1)
        ]
        return [(q + dq, r + dr) for dq, dr in directions]

    def generate_map(self, radius: int):
        # Weights: Plains 50%, Forest 20%, Mountain 20%, Water 10%
        terrain_options = [
            TerrainType.PLAINS, TerrainType.FOREST, 
            TerrainType.MOUNTAIN, TerrainType.WATER
        ]
        weights = [0.5, 0.2, 0.2, 0.1]

        for q in range(-radius, radius + 1):
            for r in range(max(-radius, -q - radius), min(radius, -q + radius) + 1):
                terrain = random.choices(terrain_options, weights=weights)[0]
                self.tiles[(q, r)] = HexTile(q, r, terrain)

class FogOfWar:
    def __init__(self):
        self.discovered: Set[Tuple[int, int]] = set()

    def discover(self, q: int, r: int):
        self.discovered.add((q, r))

    def is_visible(self, q: int, r: int) -> bool:
        return (q, r) in self.discovered

def render_map(world_map: WorldMap, fog: FogOfWar):
    if not world_map.tiles:
        print("Map is empty.")
        return

    qs = [t.q for t in world_map.tiles.values()]
    rs = [t.r for t in world_map.tiles.values()]
    min_r, max_r = min(rs), max(rs)

    print("\n--- World Map ---")
    for r in range(min_r, max_r + 1):
        indent = " " * (abs(r) % 2) 
        row_str = indent
        current_row_tiles = sorted([t for t in world_map.tiles.values() if t.r == r], key=lambda x: x.q)
        for tile in current_row_tiles:
            char = tile.terrain_type.name[0] if fog.is_visible(tile.q, tile.r) else "?"
            row_str += f" {char} "
        print(row_str)
    print("-----------------\n")
    print("Legend: P: Plains, M: Mountain, F: Forest, W: Water, ?: Hidden\n")

if __name__ == "__main__":
    world = WorldMap()
    fog = FogOfWar()
    world.generate_map(5)
    
    # Initial state: Hidden
    render_map(world, fog)
    
    # Discover center and neighbors
    center = (0, 0)
    fog.discover(*center)
    for neighbor in world.get_neighbors(*center):
        fog.discover(*neighbor)
        
    render_map(world, fog)
```

